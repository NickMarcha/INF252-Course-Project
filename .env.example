# Copy this file to .env and add your Google Routes API key.
# Never commit .env to git.
GOOGLE_ROUTES_API_KEY=your_key_here

# Set to 1 to bypass cache and always fetch from API (for development)
# FORCE_ROUTES_FETCH=1

# Frost API (historical weather). Get client ID: https://frost.met.no/auth/requestCredentials.html
FROST_API_CLIENT_ID=your_client_id_here
# MET requires a User-Agent with contact info to avoid 403. Example:
# FROST_USER_AGENT=INF252-Course-Project/1.0 (your.email@example.com)
---
import 'leaflet/dist/leaflet.css';

const base = import.meta.env.BASE_URL;
const repoUrl = 'https://github.com/NickMarcha/INF252-Course-Project';
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="Oslo on Two Wheels: an interactive data story about Oslo Bysykkel city bikes." />
  <title>Oslo on Two Wheels</title>
  <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,700;9..144,800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <style>
    /* ── Reset & base ─────────────────────────────────────────────────────── */
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; font-size: 18px; }
    body {
      font-family: 'Inter', system-ui, -apple-system, sans-serif;
      background: #fafaf8;
      color: #1c1c1e;
      line-height: 1.6;
      overflow-x: hidden;
    }

    /* ── Loading overlay ──────────────────────────────────────────────────── */
    #vs-loading {
      position: fixed;
      inset: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      background: #fafaf8;
      font-size: 1rem;
      color: #6b7280;
      z-index: 9999;
      letter-spacing: 0.04em;
    }

    /* ── Hero ─────────────────────────────────────────────────────────────── */
    #hero {
      position: relative;
      height: 100vh;
      overflow: hidden;
    }
    #hero-map {
      position: absolute;
      inset: 0;
      z-index: 0;
    }
    .hero-overlay {
      position: absolute;
      inset: 0;
      z-index: 10;
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding: 3rem 4rem;
      background: linear-gradient(105deg, rgba(0,0,0,0.72) 0%, rgba(0,0,0,0.28) 55%, transparent 80%);
      pointer-events: none;
    }
    .hero-label {
      font-size: 0.75rem;
      font-weight: 600;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: #f97316;
      margin-bottom: 1rem;
    }
    .hero-title {
      font-family: 'Fraunces', 'Fraunces', Georgia, serif;
      font-size: clamp(2.8rem, 7vw, 5.5rem);
      font-weight: 700;
      color: #fff;
      line-height: 1.08;
      margin-bottom: 1rem;
    }
    .hero-sub {
      font-size: clamp(1rem, 2vw, 1.2rem);
      color: rgba(255,255,255,0.78);
      max-width: 34rem;
      margin-bottom: 2.5rem;
    }
    .hero-stats {
      display: flex;
      gap: 2.5rem;
      flex-wrap: wrap;
      margin-bottom: 3rem;
    }
    .hero-stat {
      display: flex;
      flex-direction: column;
    }
    .hero-stat-value {
      font-family: 'Fraunces', Georgia, serif;
      font-size: clamp(1.7rem, 3.5vw, 2.4rem);
      font-weight: 700;
      color: #f97316;
      font-variant-numeric: tabular-nums;
      line-height: 1.1;
    }
    .hero-stat-label {
      font-size: 0.78rem;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: rgba(255,255,255,0.6);
      margin-top: 0.15rem;
    }
    .scroll-hint {
      font-size: 0.85rem;
      color: rgba(255,255,255,0.5);
      letter-spacing: 0.05em;
      animation: bounce 2s ease-in-out infinite;
    }
    @keyframes bounce {
      0%, 100% { transform: translateY(0); }
      50% { transform: translateY(6px); }
    }

    /* ── Chapter layout ───────────────────────────────────────────────────── */
    .vs-chapter {
      position: relative;
      min-height: 280vh;
    }
    .vs-chapter.ch-3step { min-height: 280vh; }
    .vs-chapter.ch-4step { min-height: 350vh; }

    .vs-sticky {
      position: sticky;
      top: 0;
      height: 100vh;
      width: 100%;
      background: #fff;
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }
    .vs-sticky.map-bg { background: #f0f4f8; }


    .chart-wrap {
      flex: 1;
      position: relative;
      overflow: hidden;
      padding: 2.5rem 2.5rem 1rem;
    }
    .chart-wrap svg {
      width: 100%;
      height: 100%;
      display: block;
    }
    .chart-wrap text {
      font-family: inherit;
    }

    /* When-riding chapter: linked bars + scatter + optional hourly */
    .chart-wrap.viz-when-wrap {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
      flex: 1 1 auto;
      min-height: 0;
      /* Allow scroll when hourly row opens so panels need not shrink (avoids bar/scatter resize + full D3 repaint). */
      overflow-x: hidden;
      overflow-y: auto;
      /* Reserve space so absolute hint does not cover charts */
      padding-top: 2.85rem;
    }
    .viz-when-hint-top {
      position: absolute;
      top: 0.55rem;
      bottom: auto;
      left: 50%;
      transform: translateX(-50%);
      z-index: 800;
      max-width: min(40rem, calc(100% - 2rem));
    }
    .viz-when-panels {
      display: grid;
      grid-template-columns: 1fr 1fr;
      grid-template-rows: minmax(280px, 1fr);
      gap: 0.75rem;
      flex: 1 1 auto;
      flex-shrink: 0;
      min-height: min(52vh, 580px);
      align-content: stretch;
    }
    @media (max-width: 960px) {
      .viz-when-panels {
        grid-template-columns: 1fr;
        grid-template-rows: minmax(240px, 38vh) minmax(260px, 38vh);
        min-height: min(72vh, 720px);
      }
    }
    .viz-when-panel {
      position: relative;
      min-height: 240px;
      height: 100%;
      border: 1px solid #e5e7eb;
      border-radius: 0.5rem;
      background: #fafafa;
      overflow: hidden;
    }
    /* Main two charts: reserve vertical space in layout even though SVG is absolutely positioned */
    #ch-when .viz-when-panels > .viz-when-panel {
      min-height: max(280px, 36vh);
    }
    /* Fill panel: percentage height on SVG breaks under flex; use inset instead */
    .viz-when-panel > svg {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      display: block;
    }
    .viz-when-hourly-row {
      flex: 0 0 auto;
      min-height: 0;
      max-height: 0;
      opacity: 0;
      overflow: hidden;
      transition: max-height 0.45s ease, opacity 0.35s ease;
    }
    .viz-when-hourly-row.is-visible {
      max-height: 200px;
      min-height: 140px;
      opacity: 1;
    }
    .vs-when-footnote {
      font-size: 0.72rem;
      color: #64748b;
      text-align: center;
      padding: 0.15rem 0.75rem 0.35rem;
      margin: 0;
      line-height: 1.35;
      font-weight: 500;
    }

    .map-wrap {
      flex: 1;
      position: relative;
    }
    #viz-balance-map,
    #viz-routes-map {
      position: absolute;
      inset: 0;
    }

    .viz-map-hint {
      position: absolute;
      left: 50%;
      transform: translateX(-50%);
      z-index: 750;
      pointer-events: none;
      margin: 0;
      padding: 0.45rem 0.75rem;
      font-size: 0.75rem;
      font-weight: 700;
      color: #94a3b8;
      text-align: center;
      line-height: 1.35;
      max-width: min(22rem, calc(100% - 2rem));
      background: rgba(255, 255, 255, 0.94);
      border-radius: 0.5rem;
      border: 1px solid #e5e7eb;
      box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
    }
    #viz-balance-hint {
      bottom: 5rem;
    }
    #viz-routes-hint {
      bottom: 2.75rem;
    }

    /* Sits just right of Leaflet’s default top-left zoom (+/−); :global = buttons are created in charts.ts */
    :global(.viz-map-reset) {
      position: absolute;
      top: 0.65rem;
      left: 3.1rem;
      z-index: 1200;
      padding: 0.35rem 0.55rem;
      font-size: 0.7rem;
      font-weight: 600;
      font-family: inherit;
      line-height: 1.2;
      color: #374151;
      background: rgba(255, 255, 255, 0.97);
      border: 1px solid #d1d5db;
      border-radius: 0.45rem;
      box-shadow: 0 1px 4px rgba(0, 0, 0, 0.12);
      cursor: pointer;
      transition: opacity 0.15s ease, border-color 0.15s ease, color 0.15s ease;
    }
    :global(.viz-map-reset:hover:not(:disabled)) {
      background: #fff;
      border-color: #9ca3af;
      color: #111827;
    }
    :global(.viz-map-reset:disabled) {
      opacity: 0.55;
      cursor: default;
      box-shadow: none;
    }

    /* Balance legend sits at bottom of sticky map */
    #balance-legend {
      position: absolute;
      bottom: 1rem;
      left: 50%;
      transform: translateX(-50%);
      z-index: 800;
      background: rgba(255,255,255,0.92);
      border-radius: 0.5rem;
      padding: 0.5rem 0.75rem;
      box-shadow: 0 2px 12px rgba(0,0,0,0.1);
    }

    /* ── Scroll steps ─────────────────────────────────────────────────────── */
    .vs-steps {
      pointer-events: none;
      position: absolute;
      top: 0;
      right: 2rem;
      width: 34%;
    }
    .vs-step {
      min-height: 80vh;
      display: flex;
      align-items: center;
    }
    .vs-card {
      background: rgba(255,255,255,0.95);
      border-radius: 1rem;
      padding: 1.4rem 1.6rem;
      box-shadow: 0 4px 32px rgba(0,0,0,0.08), 0 1px 3px rgba(0,0,0,0.06);
      width: 100%;
      border-left: 3px solid transparent;
      transition: border-color 0.25s ease, box-shadow 0.25s ease;
    }
    .vs-step.is-active .vs-card {
      border-left-color: #f97316;
      box-shadow: 0 6px 36px rgba(249,115,22,0.12), 0 1px 3px rgba(0,0,0,0.06);
    }
    .vs-card h3 {
      font-family: 'Fraunces', Georgia, serif;
      font-size: 1rem;
      font-weight: 700;
      color: #111827;
      margin-bottom: 0.5rem;
      letter-spacing: -0.01em;
    }
    .vs-card p {
      font-size: 0.875rem;
      color: #374151;
      line-height: 1.65;
      margin-top: 0.4rem;
    }
    .vs-card .stat {
      display: block;
      font-size: 1.9rem;
      font-weight: 800;
      color: #f97316;
      letter-spacing: -0.02em;
      margin: 0.3rem 0;
    }
    .vs-card em { color: #f97316; font-style: normal; font-weight: 600; }

    /* When chapter: copy column switches side by step (see data-when-copy-side on #ch-when).
       Use explicit `left` for both sides so it can transition (left/right `auto` does not interpolate). */
    #ch-when .vs-steps {
      right: auto;
      width: 34%;
      transition: left 0.55s cubic-bezier(0.33, 1, 0.68, 1);
    }
    #ch-when[data-when-copy-side="right"] .vs-steps {
      left: calc(100% - 34% - 2rem);
    }
    #ch-when[data-when-copy-side="left"] .vs-steps {
      left: 2rem;
    }
    @media (prefers-reduced-motion: reduce) {
      #ch-when .vs-steps {
        transition: none;
      }
    }

    /* ── Divider ──────────────────────────────────────────────────────────── */
    .section-intro {
      padding: 4rem 2rem 2rem;
      max-width: 52rem;
      margin: 0 auto;
    }
    .section-intro h2 {
      font-family: 'Fraunces', Georgia, serif;
      font-size: clamp(1.8rem, 3.5vw, 2.6rem);
      font-weight: 700;
      color: #111827;
      line-height: 1.2;
      margin-bottom: 0.75rem;
    }
    .section-intro p {
      font-size: 1rem;
      color: #6b7280;
      max-width: 44rem;
    }

    /* ── Outro ────────────────────────────────────────────────────────────── */
    #outro {
      background: #111827;
      color: #f9fafb;
      text-align: center;
      padding: 6rem 2rem;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
    }
    #outro h2 {
      font-family: 'Fraunces', Georgia, serif;
      font-size: clamp(2rem, 5vw, 3.5rem);
      font-weight: 700;
      color: #fff;
      margin-bottom: 1rem;
    }
    #outro p {
      font-size: 1.1rem;
      color: #9ca3af;
      max-width: 36rem;
      margin: 0 auto 0.75rem;
    }
    .outro-stats {
      display: flex;
      justify-content: center;
      gap: 3rem;
      margin: 2.5rem 0;
      flex-wrap: wrap;
    }
    .outro-stat { text-align: center; }
    .outro-stat-value { display: block; font-family: 'Fraunces', Georgia, serif; font-size: 2rem; font-weight: 700; color: #f97316; }
    .outro-stat-label { font-size: 0.8rem; letter-spacing: 0.08em; text-transform: uppercase; color: #6b7280; }
    .cta-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      box-sizing: border-box;
      min-height: 3.125rem;
      margin-top: 0.5rem;
      background: #f97316;
      color: #fff;
      font-weight: 600;
      font-size: 1rem;
      padding: 0.75rem 1.75rem;
      border-radius: 0.5rem;
      border: 2px solid #f97316;
      text-decoration: none;
      transition: background 0.18s ease, border-color 0.18s ease, color 0.18s ease;
    }
    .cta-btn:hover {
      background: #ea6b0c;
      border-color: #ea6b0c;
    }
    .cta-btn--secondary {
      background: #fff;
      color: #374151;
      border-color: #e5e7eb;
    }
    .cta-btn--secondary:hover {
      background: #f9fafb;
      border-color: #d1d5db;
      color: #111827;
    }
    .cta-btn--outline {
      background: transparent;
      color: #f97316;
      border-color: #f97316;
    }
    .cta-btn--outline:hover {
      background: rgba(249, 115, 22, 0.12);
      color: #fb923c;
      border-color: #fb923c;
    }
    .outro-cta-row {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      align-items: stretch;
      gap: 0.75rem 1rem;
      margin-top: 0.5rem;
    }
    .outro-cta-row .cta-btn {
      margin-top: 0;
    }

    .outro-data {
      margin-top: 3rem;
      max-width: 36rem;
      width: 100%;
      text-align: left;
      align-self: center;
    }
    .outro-data h3 {
      font-family: 'Inter', system-ui, sans-serif;
      font-size: 0.75rem;
      font-weight: 600;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: #9ca3af;
      margin-bottom: 0.65rem;
    }
    .outro-data-intro {
      font-size: 0.85rem;
      color: #9ca3af;
      margin: 0 0 1rem;
      line-height: 1.5;
    }
    .outro-data dl {
      margin: 0;
    }
    .outro-data dt {
      font-size: 0.8rem;
      font-weight: 600;
      color: #e5e7eb;
      margin-top: 0.85rem;
    }
    .outro-data dl dt:first-of-type {
      margin-top: 0;
    }
    .outro-data dd {
      margin: 0.3rem 0 0 0;
      font-size: 0.85rem;
      color: #9ca3af;
      line-height: 1.45;
    }
    .outro-data a {
      color: #f97316;
      font-weight: 600;
      text-decoration: none;
    }
    .outro-data a:hover {
      text-decoration: underline;
      color: #ea580c;
    }

    /* ── Tooltip ──────────────────────────────────────────────────────────── */
    #vs-tooltip {
      position: fixed;
      display: none;
      background: rgba(17,24,39,0.95);
      color: #f9fafb;
      font-size: 0.8rem;
      padding: 0.55rem 0.85rem;
      border-radius: 0.5rem;
      pointer-events: none;
      z-index: 500;
      white-space: nowrap;
      box-shadow: 0 4px 20px rgba(0,0,0,0.4);
    }

    /* ── Responsive ───────────────────────────────────────────────────────── */
    @media (max-width: 768px) {
      .hero-overlay { padding: 2rem; }
      .vs-chapter { min-height: unset; }
      .vs-sticky { position: relative; height: 65vw; min-height: 300px; }
      .vs-steps { position: static; width: 100%; padding: 0 1rem 2rem; }
      .vs-step { min-height: unset; padding: 0.5rem 0; }
      #ch-when .vs-steps {
        left: auto;
        right: auto;
        width: 100%;
        transition: none;
      }
    }
  </style>
</head>

<body>
  <div id="vs-loading">Loading story…</div>
  <div id="vs-tooltip"></div>

  <!-- ── Hero ── -->
  <section id="hero">
    <div id="hero-map"></div>
    <div class="hero-overlay">
      <span class="hero-label">Oslo Bysykkel · Data Story</span>
      <h1 class="hero-title">Oslo<br/>on Two Wheels</h1>
      <p class="hero-sub">Six years of city cycling: where people go, when they ride, and what the data reveals about life on Oslo's streets.</p>
      <div class="hero-stats">
        <div class="hero-stat">
          <span class="hero-stat-value" id="stat-trips">—</span>
          <span class="hero-stat-label">trips taken</span>
        </div>
        <div class="hero-stat">
          <span class="hero-stat-value" id="stat-stations">—</span>
          <span class="hero-stat-label">stations</span>
        </div>
        <div class="hero-stat">
          <span class="hero-stat-value">6</span>
          <span class="hero-stat-label">years of data</span>
        </div>
      </div>
      <div class="scroll-hint">Scroll to explore ↓</div>
    </div>
  </section>

  <!-- ── Chapter 1: Yearly trends ── -->
  <section class="vs-chapter ch-4step" id="ch-yearly">
    <div class="vs-sticky">
      <div class="chart-wrap">
        <svg id="viz-yearly"></svg>
      </div>
    </div>
    <div class="vs-steps">

      <div class="vs-step" data-chapter="yearly" data-step="0">
        <div class="vs-card">
          <h3>An enthusiastic launch</h3>
          <span class="stat">~2.2M trips</span>
          <p>Oslo Bysykkel launched in April 2019 with 292 stations across the inner city. The debut season attracted over two million trips, a high-water mark for a city that had never had city bikes before.</p>
        </div>
      </div>

      <div class="vs-step" data-chapter="yearly" data-step="1">
        <div class="vs-card">
          <h3>2020: pandemic year</h3>
          <span class="stat">~1.7M trips</span>
          <p>COVID-19 lockdowns emptied city streets in spring 2020. Ridership fell by nearly a quarter. People still cycled, but far fewer of them.</p>
        </div>
      </div>

      <div class="vs-step" data-chapter="yearly" data-step="2">
        <div class="vs-card">
          <h3>2021–2022: further decline</h3>
          <span class="stat">~1.3–1.4M trips</span>
          <p>Paradoxically, ridership fell <em>further</em> as the city reopened. Even the pandemic year's 1.7M couldn't be matched. Many first-time riders from 2019 simply didn't come back. A structural shift, not a temporary dip.</p>
        </div>
      </div>

      <div class="vs-step" data-chapter="yearly" data-step="3">
        <div class="vs-card">
          <h3>2023–2025: a loyal core</h3>
          <span class="stat">~1.1M trips/yr</span>
          <p>By 2023 the decline had stabilised. Around <em>one million trips</em> per year (roughly half the 2019 peak) represents the network's committed, regular user base.</p>
        </div>
      </div>

    </div>
  </section>

  <!-- ── Chapter 2: Seasonal patterns ── -->
  <section class="vs-chapter ch-4step" id="ch-seasonal">
    <div class="vs-sticky">
      <div class="chart-wrap">
        <svg id="viz-seasonal"></svg>
      </div>
    </div>
    <div class="vs-steps">

      <div class="vs-step" data-chapter="seasonal" data-step="0">
        <div class="vs-card">
          <h3>A summer sport</h3>
          <p>Oslo's bike season is strikingly short. In 2019, nearly all trips happened between <em>May and October</em>. The January–March period is almost silent across every year in the data.</p>
        </div>
      </div>

      <div class="vs-step" data-chapter="seasonal" data-step="1">
        <div class="vs-card">
          <h3>The pattern repeats</h3>
          <p>Each year follows the same arc: a sharp spring ramp in April–May, a broad summer plateau, then a rapid autumn retreat. The <em>shape</em> is remarkably consistent, even as total volumes have changed.</p>
        </div>
      </div>

      <div class="vs-step" data-chapter="seasonal" data-step="2">
        <div class="vs-card">
          <h3>Summer peak: June–August</h3>
          <p>The shaded band marks June, July, and August: Oslo's golden cycling window. Trip counts in this period are roughly <em>three to four times</em> higher than in the quietest winter months.</p>
        </div>
      </div>

      <div class="vs-step" data-chapter="seasonal" data-step="3">
        <div class="vs-card">
          <h3>Six years, one shape</h3>
          <p>With all years overlaid, the consistency is striking. What changes year to year is only the scale; the shape barely moves. Oslo's cycling rhythm is deeply tied to its seasons.</p>
        </div>
      </div>

    </div>
  </section>

  <!-- ── Chapter 2b: When people ride ── -->
  <section class="vs-chapter ch-4step" id="ch-when" data-when-copy-side="right">
    <div class="vs-sticky">
      <div class="chart-wrap viz-when-wrap">
        <p id="viz-when-hint" class="viz-map-hint viz-when-hint-top">Left: Minutes / Trips toggle (top-left), then hover bars. Right: 4×4 scatter matrix — hover a cell; click to enlarge — Back or Esc returns.</p>
        <div class="viz-when-panels">
          <div class="viz-when-panel" aria-label="Time-of-day bucket chart: toggle Minutes or Trips per calendar day, four calendar contexts">
            <svg id="viz-when-bars"></svg>
          </div>
          <div class="viz-when-panel" aria-label="Scatter matrix: daily precipitation, temperature, trip count, and average trip time; click a panel to expand">
            <svg id="viz-when-scatter"></svg>
          </div>
        </div>
        <div class="viz-when-hourly-row" id="viz-when-hourly-row">
          <div class="viz-when-panel" style="min-height:120px;max-height:160px;" aria-label="Trip starts by hour: riding time and trip counts">
            <svg id="viz-when-hourly"></svg>
          </div>
          <p id="viz-when-footnote" class="vs-when-footnote" style="display:none;"></p>
        </div>
      </div>
    </div>
    <div class="vs-steps">

      <div class="vs-step" data-chapter="when" data-step="0">
        <div class="vs-card">
          <h3>Morning and afternoon peaks</h3>
          <p>On ordinary weekdays (Mon–Fri, not a public holiday), the tallest bars sit in the morning commute, midday, and afternoon commute buckets. The left chart splits starts into Oslo time buckets; each bar is total riding time from trips that start in that bucket, averaged per calendar day in that weekday, weekend, or holiday slice.</p>
        </div>
      </div>

      <div class="vs-step" data-chapter="when" data-step="1">
        <div class="vs-card">
          <h3>Weekends and public holidays</h3>
          <p>Saturday and Sunday smooth the two rush spikes: more riding in the middle of the day and in the evening, less in narrow peaks. A weekday that is a Norwegian public holiday reads closer to a Saturday than to a normal Monday: the commute-shaped bars shrink and the rest of the day carries more of the total.</p>
          <p>The four bar colours split weekday vs weekend and holiday vs not. Minutes and Trips only change the vertical scale.</p>
        </div>
      </div>

      <div class="vs-step" data-chapter="when" data-step="2">
        <div class="vs-card">
          <h3>Weather and same-day riding</h3>
          <p>The right chart is a 4×4 matrix of the same calendar days: rain and temperature at Blindern, trip count, and mean trip length in minutes. Off-diagonal cells plot two measures against each other; the diagonal names the axis. One dot is one day; stacked dots read darker.</p>
          <p>Everything is network-wide for that date, not “rides that began in the rain.” A wet day can line up with shorter or longer typical trips for many overlapping reasons.</p>
        </div>
      </div>

      <div class="vs-step" data-chapter="when" data-step="3">
        <div class="vs-card">
          <h3>Starts through the day</h3>
          <p>The strip below is trip starts by clock hour in Oslo. Solid blue and solid teal lines are average riding minutes per day from trips that start in that hour (weekday Mon–Fri vs weekend Sat–Sun). Dashed lines in the same colours use the right-hand scale: average trips per day by start hour, so you can line up how often people leave with how many minutes those hours add.</p>
          <p>Each trip is counted in its start hour only, so very long rides do not spread across the hours they span; hourly sums can fall short of whole-network minutes for the day (see footnote).</p>
        </div>
      </div>

    </div>
  </section>

  <!-- ── Chapter 3: Station balance map ── -->
  <section class="vs-chapter ch-4step" id="ch-balance">
    <div class="vs-sticky map-bg">
      <div class="map-wrap">
        <div id="viz-balance-map"></div>
        <p id="viz-balance-hint" class="viz-map-hint">Hover a station for departures, arrivals, and net flow.</p>
        <div id="balance-legend"></div>
      </div>
    </div>
    <div class="vs-steps">

      <div class="vs-step" data-chapter="balance" data-step="0">
        <div class="vs-card">
          <h3>A network of stations</h3>
          <p>Oslo Bysykkel has over 200 docking stations spread across the city. Each dot on the map represents one station. The size reflects how busy it is: bigger dots mean more total trips.</p>
        </div>
      </div>

      <div class="vs-step" data-chapter="balance" data-step="1">
        <div class="vs-card">
          <h3>The flow is uneven</h3>
          <p>Not all stations are equal. <em style="color:#2563eb">Blue stations</em> send more bikes out than they receive; they're departure hubs, where journeys begin. <em style="color:#dc2626">Red stations</em> receive more bikes than they send; they're where bikes end up.</p>
          <p>This imbalance is a daily challenge for the operators, who rebalance the fleet with vans overnight.</p>
        </div>
      </div>

      <div class="vs-step" data-chapter="balance" data-step="2">
        <div class="vs-card">
          <h3>The biggest departure hub</h3>
          <p>The highlighted station is Oslo's largest net departure point: far more bikes leave than arrive. It likely sits near a residential area where commuters start their morning rides.</p>
          <p>Hover over it to see the numbers.</p>
        </div>
      </div>

      <div class="vs-step" data-chapter="balance" data-step="3">
        <div class="vs-card">
          <h3>The biggest arrival hub</h3>
          <p>Conversely, this station absorbs far more bikes than it releases. It's likely near a transit node or workplace where journeys end; bikes pile up here each morning.</p>
        </div>
      </div>

    </div>
  </section>

  <!-- ── Chapter 4: Routes map ── -->
  <section class="vs-chapter ch-4step" id="ch-routes">
    <div class="vs-sticky map-bg">
      <div class="map-wrap">
        <div id="viz-routes-map"></div>
        <p id="viz-routes-hint" class="viz-map-hint">Hover a route for distance, time, and trip counts; hover a station for its name.</p>
      </div>
    </div>
    <div class="vs-steps">

      <div class="vs-step" data-chapter="routes" data-step="0">
        <div class="vs-card">
          <h3>A web of routes</h3>
          <p>Each line shows an actual bike route between two stations, calculated using the city's cycling network. Together they trace the skeleton of how Oslo moves on two wheels.</p>
          <p>Hover over any line to see origin, destination, distance and estimated ride time.</p>
        </div>
      </div>

      <div class="vs-step" data-chapter="routes" data-step="1">
        <div class="vs-card">
          <h3>The busiest corridors</h3>
          <p>The <em>highlighted routes</em> are the most frequently used short connections in the network: compact urban trips, typically under 2 km, that fit neatly into a commute or lunch break.</p>
          <p>These are the arteries of Oslo's cycling city.</p>
        </div>
      </div>

      <div class="vs-step" data-chapter="routes" data-step="2">
        <div class="vs-card">
          <h3>Concentrated in the core</h3>
          <p>The busiest routes cluster tightly in central Oslo and the western harbour area. These short, flat connections are ideal for city bikes: no hills, no long distances, just effortless urban movement.</p>
        </div>
      </div>

      <div class="vs-step" data-chapter="routes" data-step="3">
        <div class="vs-card">
          <h3>Where time is spent</h3>
          <p>Multiplying trip count by ride duration reveals which corridors account for the most <em>total cycling time</em>. These are not necessarily the most frequent routes; longer rides to more distant destinations contribute disproportionate hours.</p>
          <p>Highlighted in <span style="color:#10b981;font-weight:600;">teal</span> are the routes where Osloans have collectively spent the most time in the saddle: not the most frequent, but the ones where long distances add up to outsized hours.</p>
        </div>
      </div>

    </div>
  </section>

  <!-- ── Outro ── -->
  <section id="outro">
    <h2>Ready to Ride?</h2>
    <p>City bikes are Oslo's fastest, cheapest way to cross the city.<br/>Every trip is one less car on the road.</p>
    <div class="outro-stats">
      <div class="outro-stat">
        <span class="outro-stat-value">~11 min</span>
        <span class="outro-stat-label">avg trip duration</span>
      </div>
      <div class="outro-stat">
        <span class="outro-stat-value">253</span>
        <span class="outro-stat-label">stations citywide</span>
      </div>
      <div class="outro-stat">
        <span class="outro-stat-value">Year-round</span>
        <span class="outro-stat-label">winter bikes with spiked tires</span>
      </div>
    </div>
    <div class="outro-cta-row">
      <a href={base} class="cta-btn cta-btn--outline">Project Home</a>
      <a href={repoUrl} target="_blank" rel="noopener noreferrer" class="cta-btn cta-btn--secondary">View on GitHub</a>
      <a href="https://oslobysykkel.no" target="_blank" rel="noopener noreferrer" class="cta-btn">
        Find a bike near you →
      </a>
    </div>
    <div class="outro-data">
      <h3>Data sources</h3>
      <p class="outro-data-intro">
        Aggregates and map layers are built from open data spanning roughly <strong>April&nbsp;2019–January&nbsp;2026</strong> (trips and daily weather aligned by date).
      </p>
      <dl>
        <dt>Historical bike trips and station activity</dt>
        <dd>
          <a href="https://oslobysykkel.no/en/open-data/historical" target="_blank" rel="noopener noreferrer">Oslo Bysykkel — historical open data</a>
          (Urban Sharing · <span style="white-space:nowrap;">data.urbansharing.com</span>)
        </dd>
        <dt>Daily weather (Oslo Blindern)</dt>
        <dd>
          <a href="https://frost.met.no/" target="_blank" rel="noopener noreferrer">MET Norway — Frost API</a>

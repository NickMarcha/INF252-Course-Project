---
const base = import.meta.env.BASE_URL;

const experimentLinks: { href: string; label: string }[] = [
	{ href: `${base}data-test/`, label: 'Data Test' },
	{ href: `${base}isochrone/`, label: 'Isochrone Map' },
	{ href: `${base}route-test/`, label: 'Route Test' },
	{ href: `${base}region-flow/`, label: 'Region flow' },
	{ href: `${base}station-in-out/`, label: 'Station in/out' },
	{ href: `${base}weather/`, label: 'Weather' },
	{ href: `${base}elevation-test/`, label: 'Elevation Test' },
	{ href: `${base}live/`, label: 'Live' },
	{ href: `${base}story/`, label: 'Story' },
	{ href: `${base}story-news/`, label: 'Story (news quiz)' },
];
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
		<meta name="generator" content={Astro.generator} />
		<title>INF252 Course Project</title>
	</head>
	<body class="bg-white dark:bg-slate-900">
		<nav
			class="border-b border-slate-200 dark:border-slate-700 px-6 py-3 flex flex-wrap items-center gap-x-4 gap-y-2 relative z-50"
		>
			<a
				href={base}
				class="text-slate-600 hover:text-slate-900 dark:text-slate-300 dark:hover:text-slate-100 focus:outline-none focus-visible:ring-2 focus-visible:ring-orange-500 rounded"
				>Home</a
			>
			<a
				href={`${base}visual-story/`}
				class="text-slate-600 hover:text-slate-900 dark:text-slate-300 dark:hover:text-slate-100 font-medium focus:outline-none focus-visible:ring-2 focus-visible:ring-orange-500 rounded"
				>Story</a
			>
			<a
				href="https://github.com/NickMarcha/INF252-Course-Project"
				target="_blank"
				rel="noopener noreferrer"
				class="text-slate-600 hover:text-slate-900 dark:text-slate-300 dark:hover:text-slate-100 focus:outline-none focus-visible:ring-2 focus-visible:ring-orange-500 rounded"
				>GitHub</a
			>
			<details class="relative">
				<summary
					class="cursor-pointer list-none text-slate-600 hover:text-slate-900 dark:text-slate-300 dark:hover:text-slate-100 focus:outline-none focus-visible:ring-2 focus-visible:ring-orange-500 rounded px-0.5 [&::-webkit-details-marker]:hidden"
				>
					Experiments
					<span class="text-slate-400 dark:text-slate-500" aria-hidden="true">▾</span>
				</summary>
				<div
					class="absolute left-0 top-full mt-1 min-w-[12rem] py-1 rounded-md border border-slate-200 dark:border-slate-600 bg-white dark:bg-slate-800 shadow-lg flex flex-col z-50"
				>
					{
						experimentLinks.map(({ href, label }) => (
							<a
								href={href}
								class="px-3 py-2 text-sm text-slate-700 hover:bg-slate-100 dark:text-slate-200 dark:hover:bg-slate-700 focus:outline-none focus-visible:bg-slate-100 dark:focus-visible:bg-slate-700"
							>
								{label}
							</a>
						))
					}
				</div>
			</details>
		</nav>
		<slot />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>
